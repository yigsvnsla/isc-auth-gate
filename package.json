{
  "name": "isc-auth-gate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "auth:generate": "bun x auth@latest generate --config ./lib/auth.ts --output ./database/schema.ts --yes",
    "database:up": "bun x drizzle-kit up",
    "database:push": "bun x drizzle-kit push",
    "database:check": "bun x drizzle-kit check",
    "database:generate": "bun x drizzle-kit generate",
    "database:studio": "bunx --bun drizzle-kit studio --port 4001 --verbose",
    "email:server": "bun maildev",
    "email:dev": "email dev --dir lib/email/templates --port 3001",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "seed:run": "bun run tests/seed.ts seed",
    "seed:reset": "bun run tests/seed.ts reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/oauth-provider": "1.6.12",
    "@hookform/resolvers": "^5.7.1",
    "@opencoredev/email-sdk": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-email/tailwind": "^2.0.7",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jotai": "^2.20.2",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.28.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.84.0",
    "recharts": "3.8.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@react-email/ui": "6.6.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/lodash.debounce": "^4.0.9",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "maildev": "^3.0.0-rc.1",
    "prettier": "^3.9.6",
    "swr-devtools": "^1.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

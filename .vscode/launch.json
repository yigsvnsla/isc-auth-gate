{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "attach",
      "name": "Next.js (Bun): attach",
      "url": "ws://localhost:6499/",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Next.js (Bun): launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "-p", "3000"],
      "runtimeArgs": ["--inspect-wait"],
      "cwd": "${workspaceFolder}",
      "stopOnEntry": false
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Next.js: cliente (Chrome)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}

# usar la imagen oficial de Bun
FROM oven/bun:1 AS base
WORKDIR /usr/src/app

# instalar dependencias en directorio temporal esto las cacheará y acelerará futuras compilaciones
FROM base AS install
RUN mkdir -p /temp/dev
COPY package.json bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile

# instalar con --production (excluir devDependencies)
RUN mkdir -p /temp/prod
COPY package.json bun.lock /temp/prod/
RUN cd /temp/prod && bun install --frozen-lockfile --production

# copiar node_modules desde el directorio temporal luego copiar todos los archivos del proyecto (no ignorados) en la imagen
# Sólo ENVs que `next build` lee: NODE_ENV ya la fija el propio build, y
# husky/telemetría del SDK de email no corren en esta etapa.
FROM base AS prerelease
ENV NEXT_TELEMETRY_DISABLED=1

# ÚNICA build-arg que queda. Next la compila dentro del bundle del cliente, así
# que no hay forma de moverla a runtime: `lib/auth/auth-client.ts:41` la lee
# como baseURL del cliente en el browser. Sin este ARG, el bundle del cliente
# compila con baseURL undefined y el login desde el navegador falla.
ARG NEXT_PUBLIC_BETTER_AUTH_URL
ENV NEXT_PUBLIC_BETTER_AUTH_URL=${NEXT_PUBLIC_BETTER_AUTH_URL}

# SHA del commit. ARG sin ENV: RUN lo ve, next.config.ts lo compila en
# /api/health y no queda como variable en la imagen final. El workflow lo
# compara tras el deploy para no dar por bueno al contenedor anterior.
ARG APP_VERSION

# Sin placeholders de env de servidor aquí, a propósito. `lib/auth/auth.tsx`,
# `lib/providers.ts`, `lib/smtp.ts` y `database/index.ts` leen env en el scope
# del módulo, y Next ejecuta esos módulos al recolectar datos de página durante
# el build. `env/index.ts` devuelve un stub cuando no hay NINGUNA variable de la
# app presente, así que el build compila sin que la imagen contenga un secreto.
# Si alguien pega una variable mal formada, o deja el env vacío, el
# `entrypoint.ts` aborta el arranque en vez de servir ese stub.
#
# ponytail: BETTER_AUTH_URL ya no se pasa como build-arg (era otro placeholder).
# Las vars de servidor llegan en runtime desde Dokploy.

COPY --from=install /temp/dev/node_modules node_modules
COPY . .

# [opcional] tests y build
# RUN bun test
# Next.js standalone no incluye los assets estáticos: hay que copiarlos a mano
# junto al server.js o el cliente recibe 404 en cada JS/CSS chunk.
RUN bun run build && \
    mkdir -p .next/standalone/public .next/standalone/.next/static && \
    cp -r public/. .next/standalone/public/ && \
    cp -r .next/static/. .next/standalone/.next/static/

# imagen final: el output standalone (incluye public/ y .next/static porque se
# copiaron arriba dentro de .next/standalone) + las deps de producción.
# NO se copia el node_modules de dev: arrastra eslint, typescript, tailwind y
#@maildev sin uso en runtime.
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# apaga la telemetría de @opencoredev/email-sdk al enviar correo
ENV DO_NOT_TRACK=1
# Next standalone bindea a process.env.HOSTNAME, que el runtime de contenedores
# define como el ID/hostname del contenedor: el puerto publicado queda
# inalcanzable. Forzamos todas las interfaces.
ENV HOSTNAME=0.0.0.0

COPY --from=prerelease /usr/src/app/.next/standalone ./
COPY --from=prerelease /usr/src/app/public ./public
COPY --from=prerelease /usr/src/app/.next/static ./.next/static
# deps de producción: el standalone trae su node_modules podado (lo justo para
# server.js), sin zod ni el migrador de drizzle-orm que usa entrypoint.ts.
# drizzle-kit NO hace falta: se migra con drizzle-orm/bun-sql/migrator.
COPY --from=install /temp/prod/node_modules ./node_modules
# tsconfig.json resuelve el alias @/ de entrypoint.ts; database/ trae las
# migraciones (database/migrations) y el cliente Bun SQL.
COPY --from=prerelease /usr/src/app/tsconfig.json ./
COPY --from=prerelease /usr/src/app/database ./database
COPY --from=prerelease /usr/src/app/env ./env
COPY --from=prerelease /usr/src/app/entrypoint.ts ./
RUN chown -R bun:bun /app

USER bun
EXPOSE 3000/tcp
# /healthz es un rewrite de next.config.ts hacia /api/health
# start-period cubre la espera de DB del entrypoint (20 × (3s + 5s) ≈ 160s)
# más las migraciones: antes de eso un fallo no marca el contenedor unhealthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
  CMD bun -e "process.exit((await fetch('http://127.0.0.1:3000/healthz')).ok ? 0 : 1)"
# Migra y sólo si sale con 0 arranca Next. `exec` deja a server.js como PID 1:
# recibe SIGTERM directo de Dokploy y su exit code es el del contenedor.
ENTRYPOINT [ "sh", "-c", "bun entrypoint.ts && exec bun server.js" ]
